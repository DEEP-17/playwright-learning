{
  "loginTests": [
    {
      "testId": "login_001",
      "description": "Valid login with correct credentials",
      "emailOrPhone": "user@example.com",
      "password": "ValidPassword123",
      "expectedResult": "success",
      "tags": ["smoke", "positive"]
    },
    {
      "testId": "login_002",
      "description": "Invalid login with wrong password",
      "emailOrPhone": "user@example.com",
      "password": "WrongPassword123",
      "expectedResult": "failure",
      "tags": ["regression", "negative"]
    },
    {
      "testId": "login_003",
      "description": "Invalid login with non-existent email",
      "emailOrPhone": "nonexistent@example.com",
      "password": "AnyPassword123",
      "expectedResult": "failure",
      "tags": ["regression", "negative"]
    },
    {
      "testId": "login_004",
      "description": "Valid login with phone number",
      "emailOrPhone": "+1234567890",
      "password": "ValidPassword123",
      "expectedResult": "success",
      "tags": ["smoke", "positive"]
    },
    {
      "testId": "login_005",
      "description": "Login with empty email field",
      "emailOrPhone": "",
      "password": "ValidPassword123",
      "expectedResult": "error",
      "tags": ["regression", "validation"]
    },
    {
      "testId": "login_006",
      "description": "Login with empty password field",
      "emailOrPhone": "user@example.com",
      "password": "",
      "expectedResult": "error",
      "tags": ["regression", "validation"]
    },
    {
      "testId": "login_007",
      "description": "Login with both fields empty",
      "emailOrPhone": "",
      "password": "",
      "expectedResult": "error",
      "tags": ["regression", "validation"]
    },
    {
      "testId": "login_008",
      "description": "Valid login with special characters in email",
      "emailOrPhone": "user+test@example.com",
      "password": "ValidPassword123",
      "expectedResult": "success",
      "tags": ["smoke", "positive"]
    }
  ],
